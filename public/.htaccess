# ==================================================
# TELEGONDOLA PIATRA NEAMȚ - PRODUCTION OPTIMIZED
# Securitate maximă + Performance + Funcționalitate 100%
# ==================================================

# ============================================
# 1. FORȚARE HTTPS + WWW REDIRECT
# ============================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # HTTPS redirect
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # WWW to non-WWW
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>


# ============================================
# 2. SECURITY HEADERS - OPTIMIZAT
# ============================================
<IfModule mod_headers.c>
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # MIME type sniffing protection
    Header always set X-Content-Type-Options "nosniff"
    
    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    
    # HSTS - Forțează HTTPS (doar după ce SSL e configurat 100%)
    # Decomentează după ce site-ul merge perfect pe HTTPS:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    
    # Ascunde server info
    Header unset Server
    Header unset X-Powered-By
    
# CSP - Ultra permisiv pentru Google Maps + Toate serviciile
Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:; style-src 'self' 'unsafe-inline' https: data:; font-src 'self' https: data:; img-src 'self' data: https: blob:; connect-src 'self' https: wss:; frame-src 'self' https:; child-src 'self' https: blob:; worker-src 'self' https: blob:; object-src 'none';"
</IfModule>

# Ascunde Apache signature
ServerSignature Off


# ============================================
# 3. PROTECȚIE FIȘIERE SENSIBILE
# ============================================
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Blochează fișiere specifice
<FilesMatch "(^\.htaccess|^\.htpasswd|\.env|\.git|\.log|\.md|package\.json|package-lock\.json|composer\.json|composer\.lock|yarn\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>


# ============================================
# 4. PROTECȚIE DIRECTORY TRAVERSAL & XSS
# ============================================
<IfModule mod_rewrite.c>
    # Directory traversal
    RewriteCond %{QUERY_STRING} \.\./  [NC,OR]
    RewriteCond %{QUERY_STRING} boot\.ini [NC,OR]
    RewriteCond %{QUERY_STRING} tag= [NC,OR]
    RewriteCond %{QUERY_STRING} ftp:  [NC,OR]
    RewriteCond %{QUERY_STRING} http:  [NC,OR]
    RewriteCond %{QUERY_STRING} https:  [NC,OR]
    RewriteCond %{QUERY_STRING} mosConfig [NC,OR]
    
    # SQL Injection basic
    RewriteCond %{QUERY_STRING} ^.*(<|%3C).*script.*(>|%3E).*$ [NC,OR]
    RewriteCond %{QUERY_STRING} ^.*(<|%3C).*iframe.*(>|%3E).*$ [NC,OR]
    RewriteCond %{QUERY_STRING} ^.*(union|select|insert|drop|update|delete|replace).* [NC]
    
    RewriteRule ^(.*)$ - [F,L]
</IfModule>


# ============================================
# 5. CACHING AGRESIV - PERFORMANCE
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Imagini - 1 an
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    
    # Video
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    
    # Fonts - 1 an
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    
    # CSS și JavaScript - 1 an
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # HTML - scurt cache
    ExpiresByType text/html "access plus 3600 seconds"
    
    # Data/JSON - no cache
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/ld+json "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Cache Control pentru assets statice
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|avif|svg|css|js|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # HTML - cache moderat
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>


# ============================================
# 6. COMPRESIE GZIP - PERFORMANCE
# ============================================
<IfModule mod_deflate.c>
    # Comprimă text
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    
    # Comprimă aplicații
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    
    # Comprimă fonts și SVG
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
</IfModule>


# ============================================
# 7. NEXT.JS ROUTING - TRAILING SLASH
# ============================================
<IfModule mod_rewrite.c>
    # Adaugă trailing slash pentru directoare
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteCond %{REQUEST_URI} !(.*)\.(.*)$
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]
    
    # Index.html pentru directoare
    DirectoryIndex index.html
    
    # 404 custom
    ErrorDocument 404 /404.html
</IfModule>


# ============================================
# 8. OPTIMIZĂRI GENERALE
# ============================================
# Disable directory browsing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# UTF-8 encoding
AddDefaultCharset UTF-8

# Disable MultiViews
Options -MultiViews

# ETags
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|css|js|woff|woff2)$">
        Header unset ETag
    </FilesMatch>
</IfModule>
FileETag None


# ============================================
# 9. PROTECȚIE HOTLINKING (Opțional)
# ============================================
# Decomentează pentru a preveni hotlinking-ul imaginilor
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTP_REFERER} !^$
#     RewriteCond %{HTTP_REFERER} !^https://(www\.)?telegondolapiatraneamt\.ro [NC]
#     RewriteRule \.(jpg|jpeg|png|gif|webp|svg)$ - [F,L]
# </IfModule>


# ============================================
# 10. BLOCHEAZĂ BOT-URI SUSPICIOUS
# ============================================
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
    RewriteCond %{HTTP_USER_AGENT} (libwww-perl|wget|python|nikto|scan|java|winhttp) [NC]
    RewriteRule .* - [F,L]
</IfModule>